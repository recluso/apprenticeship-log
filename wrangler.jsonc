{
	"$schema": "node_modules/wrangler/config-schema.json",
	// PLACEHOLDER — Cloudflare Worker names must be unique on your account;
	// change this if "apprenticeship-log" is taken.
	"name": "apprenticeship-log",
	"compatibility_date": "2026-09-22",
	// Keeps the free *.workers.dev URL live alongside the custom domain,
	// handy as a fallback / staging URL.
	"workers_dev": true,
	"assets": {
		"directory": "./dist",
		"not_found_handling": "404-page"
	},
	"routes": [{ "pattern": "testdept.co.uk", "custom_domain": true }]
}
