---
// Overrides Starlight's default Hero (only used on the home page) to feature
// the most recently dated log entry or project instead of a static title.
// Publishing a new entry updates the home page automatically. Any `actions`
// in the home page's `hero` frontmatter still render after "Read it".
// If the entry has a `cover` image in its frontmatter, it's shown on the
// right (above the text on narrow screens).
import { getDatedEntries, formatDate } from '../utils/entries';
import { Image } from 'astro:assets';
import { LinkButton } from '@astrojs/starlight/components';

const { actions = [] } = Astro.locals.starlightRoute.entry.data.hero || {};

const [latest] = await getDatedEntries();
---

<div class:list={['hero', { 'has-cover': latest?.data.cover }]}>
	{
		latest?.data.cover && (
			<div class="cover">
				<Image
					src={latest.data.cover}
					alt={latest.data.coverAlt ?? ''}
					width={560}
					loading="eager"
				/>
			</div>
		)
	}
	<div class="sl-flex stack">
		{
			latest ? (
				<div class="sl-flex copy">
					<p class="eyebrow">
						Latest {latest.id.startsWith('projects/') ? 'project' : 'entry'} ·{' '}
						{formatDate(latest.data.date!)}
					</p>
					{/* "_top" is Starlight's PAGE_TITLE_ID, used by the skip link. */}
					<h1 id="_top" data-page-title>
						<a href={`/${latest.id}/`}>{latest.data.title}</a>
					</h1>
					{latest.data.description && <p class="tagline">{latest.data.description}</p>}
				</div>
			) : (
				<h1 id="_top" data-page-title>
					Nothing published yet
				</h1>
			)
		}
		<div class="sl-flex actions">
			{
				latest && (
					<LinkButton href={`/${latest.id}/`} icon="right-arrow">
						Read it
					</LinkButton>
				)
			}
			{
				actions.map(({ icon, link, text }) => (
					<LinkButton href={link} icon={icon?.name} variant="minimal">
						{text}
					</LinkButton>
				))
			}
		</div>
	</div>
</div>

<style>
	.hero {
		display: grid;
		grid-template-columns: 100%;
		align-items: center;
		gap: 2rem;
		padding-block: clamp(2rem, calc(1rem + 8vmin), 6rem) 1rem;
	}
	.stack {
		flex-direction: column;
		gap: clamp(1.5rem, calc(1.5rem + 1vw), 2rem);
	}
	.cover {
		display: block;
		width: min(100%, 28rem);
	}
	.cover :global(img) {
		display: block;
		width: 100%;
		height: auto;
		border-radius: 1rem;
		box-shadow: var(--sl-shadow-lg);
	}
	@media (min-width: 50rem) {
		.hero.has-cover {
			grid-template-columns: 6fr 5fr;
			gap: 3rem;
		}
		.cover {
			order: 2;
			width: 100%;
		}
	}
	.copy {
		flex-direction: column;
		gap: 1rem;
		max-width: 50ch;
	}
	.eyebrow {
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-3);
		text-transform: uppercase;
		letter-spacing: 0.06em;
		margin: 0;
	}
	h1 {
		font-size: clamp(var(--sl-text-3xl), calc(0.25rem + 4vw), var(--sl-text-5xl));
		line-height: var(--sl-line-height-headings);
		font-weight: 600;
		margin: 0;
	}
	h1 a {
		color: var(--sl-color-white);
		text-decoration: none;
	}
	h1 a:hover {
		color: var(--sl-color-accent-high);
	}
	.tagline {
		font-size: clamp(var(--sl-text-base), calc(0.0625rem + 2vw), var(--sl-text-xl));
		color: var(--sl-color-gray-2);
		margin: 0;
	}
	.actions {
		gap: 1rem 2rem;
		flex-wrap: wrap;
	}
</style>
