---
// Overrides Starlight's default ThemeProvider so first-time visitors see
// dark mode, regardless of their OS/browser color-scheme preference. A
// visitor's own choice from the theme picker (stored in localStorage)
// still always wins on later visits.
//
// Icons are inlined directly (rather than importing Starlight's `Icon`
// component) because it isn't part of Starlight's public package exports.
---

{/* This is intentionally inlined to avoid FOUC. */}
<script is:inline>
	window.StarlightThemeProvider = (() => {
		const hasStorage = typeof localStorage !== 'undefined';
		const stored = hasStorage && localStorage.getItem('starlight-theme');
		// Starlight's theme picker (a separate script) re-derives "auto" from
		// scratch whenever storage holds anything other than exactly "light"
		// or "dark" — so on a first visit we persist "dark" here rather than
		// only setting it in memory, keeping both scripts in agreement.
		const storedTheme = stored === 'light' || stored === 'dark' ? stored : 'dark';
		if (hasStorage && stored !== storedTheme) {
			try {
				localStorage.setItem('starlight-theme', storedTheme);
			} catch {}
		}
		const theme = storedTheme;
		document.documentElement.dataset.theme = theme === 'light' ? 'light' : 'dark';
		return {
			updatePickers(theme = storedTheme || 'dark') {
				document.querySelectorAll('starlight-theme-select').forEach((picker) => {
					const select = picker.querySelector('select');
					if (select) select.value = theme;
					/** @type {HTMLTemplateElement | null} */
					const tmpl = document.querySelector(`#theme-icons`);
					const newIcon = tmpl && tmpl.content.querySelector('.' + theme);
					if (newIcon) {
						const oldIcon = picker.querySelector('svg.label-icon');
						if (oldIcon) {
							oldIcon.replaceChildren(...newIcon.cloneNode(true).childNodes);
						}
					}
				});
			},
		};
	})();
</script>

